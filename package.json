{
  "name": "auto-flow",
  "version": "0.3.4",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.14.0"
  },
  "description": "Personal approval-based Sharelink publishing desktop app",
  "main": "dist/main.cjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/store.test.ts src/controller.test.ts src/adapters/adapters.test.ts src/adapters/aside-client.test.ts src/adapters/aside-tasks.test.ts src/adapters/aside-workflow.test.ts src/adapters/toss-dom.test.ts src/validation.test.ts",
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder --win portable",
    "smoke": "npm run build && electron . --smoke-test",
    "live-check": "npm run build && electron . --live-check",
    "aside:check": "node --import tsx scripts/check-aside.ts",
    "aside:inspect": "node --import tsx scripts/check-aside.ts --inspect",
    "aside:products": "node --import tsx scripts/check-products.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.9.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.13",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  },
  "overrides": {
    "global-agent": "^4.1.3"
  },
  "build": {
    "appId": "local.autoflow.desktop",
    "productName": "Auto Flow",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    }
  }
}
